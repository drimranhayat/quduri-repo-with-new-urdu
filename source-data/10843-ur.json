\u0625\u0630\u0627 \u0623\u062a\u0627\u0647 \u062c\u0628\u0631\u064a\u0644 -\u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645- \u0627\u0633\u062a\u0645\u0639\u060c \u0641\u0625\u0630\u0627 \u0627\u0646\u0637\u0644\u0642 \u062c\u0628\u0631\u064a\u0644\u064f \u0642\u0631\u0623\u0647 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0643\u0645\u0627 \u0623\u0642\u0631\u0623\u0647 \u062c\u0628\u0631\u064a\u0644.","hints_ar":["\u0628\u064a\u0627\u0646 \u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u0646\u0628\u064a -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u064a\u0644\u0642\u0627\u0647 \u0645\u0646 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0634\u062f\u0629 \u0639\u0646\u062f \u0646\u0632\u0648\u0644 \u0627\u0644\u0648\u062d\u064a \u0639\u0644\u064a\u0647\u060c \u0648\u0630\u0644\u0643 \u0644\u062b\u0642\u0644 \u0627\u0644\u0648\u062d\u064a\u060c \u0643\u0645\u0627 \u0642\u0627\u0644 \u0627\u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649-: {\u0625\u0650\u0646\u0651\u064e\u0627 \u0633\u064e\u0646\u064f\u0644\u0652\u0642\u0650\u064a \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u0642\u064e\u0648\u0652\u0644\u064b\u0627 \u062b\u064e\u0642\u0650\u064a\u0644\u064b\u0627} [\u0627\u0644\u0645\u0632\u0645\u0644: 5].","\u0623\u0646\u0647 -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0643\u0627\u0646 \u064a\u062d\u0631\u0643 \u0634\u0641\u062a\u064a\u0647\u060c \u0644\u0626\u0644\u0627 \u064a\u0646\u0633\u0649\u060c \u0648\u0642\u064a\u0644: \u0625\u0646\u0645\u0627 \u0643\u0627\u0646 \u064a\u0641\u0639\u0644 \u0630\u0644\u0643 \u0645\u0646 \u062d\u0628\u0647 \u0644\u0647\u060c \u0648\u062d\u0644\u0627\u0648\u062a\u0647 \u0641\u064a \u0644\u0633\u0627\u0646\u0647\u060c \u0641\u0646\u0647\u064a \u0639\u0646 \u0630\u0644\u0643 \u062d\u062a\u0649 \u064a\u062c\u062a\u0645\u0639\u060c \u0644\u0623\u0646 \u0628\u0639\u0636\u0647 \u0645\u0631\u062a\u0628\u0637 \u0644\u0628\u0639\u0636\u0647.","\u0623\u0646 \u0627\u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649- \u062a\u0643\u0641\u0644 \u0644\u0631\u0633\u0648\u0644\u0647 -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0623\u0646 \u0644\u0627 \u064a\u0646\u0633\u0649 \u0627\u0644\u0642\u0631\u0622\u0646\u060c \u0648\u0623\u0646\u0647 \u0643\u0627\u0646 \u0628\u0639\u062f \u0646\u0632\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u0622\u064a\u0629 \u064a\u0633\u062a\u0645\u0639\u060c \u0648\u064a\u0646\u0635\u062a \u0644\u062c\u0628\u0631\u064a\u0644\u060c \u0641\u0625\u0630\u0627 \u0627\u0646\u062a\u0647\u0649 \u062c\u0628\u0631\u064a\u0644 \u0645\u0646 \u0642\u0631\u0627\u0621\u062a\u0647\u060c \u0648\u0630\u0647\u0628 \u0645\u0646 \u0639\u0646\u062f\u0647\u060c \u0642\u0631\u0623\u0647 \u0627\u0644\u0646\u0628\u064a -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0639\u0644\u0649 \u0623\u0635\u062d\u0627\u0628\u0647 \u0643\u0645\u0627 \u0623\u0642\u0631\u0623\u0647\u060c \u0645\u0646 \u063a\u064a\u0631 \u0632\u064a\u0627\u062f\u0629\u060c \u0648\u0644\u0627 \u0646\u0642\u0635\u060c \u0643\u0645\u0627 \u0642\u0627\u0644 -\u062a\u0639\u0627\u0644\u0649-: {\u0633\u064e\u0646\u064f\u0642\u0652\u0631\u0650\u0626\u064f\u0643\u064e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u0652\u0633\u064e\u0649} [\u0627\u0644\u0623\u0639\u0644\u0649: 6].","\u0648\u062c\u0648\u0628 \u0627\u062a\u0628\u0627\u0639 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0627\u0644\u0625\u0646\u0635\u0627\u062a \u0625\u0644\u064a\u0647.","\u0623\u0646 \u0641\u064a\u0647 \u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0623\u0646 \u0623\u062d\u062f\u064b\u0627 \u0644\u0627 \u064a\u062d\u0641\u0638 \u0627\u0644\u0642\u0631\u0622\u0646 \u0625\u0644\u0627 \u0628\u0639\u0648\u0646 \u0627\u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649- \u0648\u0641\u0636\u0644\u0647\u060c \u0643\u0645\u0627 \u0642\u0627\u0644 \u0627\u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649-: {\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u0652 \u064a\u064e\u0633\u0651\u064e\u0631\u0652\u0646\u064e\u0627 \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0622\u0646\u064e \u0644\u0650\u0644\u0630\u0651\u0650\u0643\u0652\u0631\u0650 \u0641\u064e\u0647\u064e\u0644\u0652 \u0645\u0650\u0646\u0652 \u0645\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u064d (17)} [\u0627\u0644\u0642\u0645\u0631: 17]."],"words_meanings_ar":[{"word":"\u064a\u064f\u0639\u0627\u0644\u0650\u062c","meaning":" \u064a\u062a\u062d\u0645\u0644 \u0648\u064a\u0639\u0627\u0646\u064a."},{"word":"\u0644\u062a\u064e\u0639\u0652\u062c\u0644 \u0628\u0647","meaning":" \u0644\u062a\u0623\u062e\u0630\u0647 \u0639\u0644\u0649 \u0639\u062c\u0644\u0629."},{"word":"\u0642\u064f\u0631\u0622\u0646\u0647","meaning":" \u0642\u0631\u0627\u0621\u062a\u0647."},{"word":"\u0641\u0627\u0633\u062a\u0645\u0639 \u0644\u0647\u060c \u0648\u0623\u0646\u0635\u0650\u062a\u0652","meaning":" \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639 \u0623\u062e\u0635 \u0645\u0646 \u0627\u0644\u0625\u0646\u0635\u0627\u062a\u060c \u0644\u0623\u0646 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639: \u0627\u0644\u0625\u0635\u063a\u0627\u0621\u060c \u0648\u0627\u0644\u0625\u0646\u0635\u0627\u062a: \u0627\u0644\u0633\u0643\u0648\u062a\u060c \u0648\u0644\u0627 \u064a\u0644\u0632\u0645 \u0645\u0646 \u0627\u0644\u0633\u0643\u0648\u062a \u0627\u0644\u0625\u0635\u063a\u0627\u0621\u060c \u0641\u0642\u062f \u064a\u0633\u062a\u0645\u0639\u060c \u0648\u0644\u0627 \u064a\u0646\u0635\u062a\u060c \u0641\u0644\u0647\u0630\u0627 \u062c\u064f\u0645\u0650\u0639\u064e \u0628\u064a\u0646\u0647\u0645\u0627\u060c \u0643\u0645\u0627 \u0642\u0627\u0644 \u0627\u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649-: {\u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0645\u0650\u0639\u064f\u0648\u0627 \u0644\u064e\u0647\u064f \u0648\u064e\u0623\u064e\u0646\u0652\u0635\u0650\u062a\u064f\u0648\u0627} [\u0627\u0644\u0623\u0639\u0631\u0627\u0641: 204]."},{"word":"\u0641\u064a \u0642\u0648\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649","meaning":" \u0623\u064a \u0641\u064a \u062a\u0648\u0636\u064a\u062d\u0650 \u0645\u0639\u0627\u0646\u064a\u0647\u060c \u0648\u0628\u064a\u0627\u0646 \u0633\u0628\u0628 \u0646\u0632\u0648\u0644\u0647."},{"word":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064e\u0631\u064e\u0623\u0652\u0646\u064e\u0627\u0647\u064f","meaning":" \u0623\u064a \u0625\u0630\u0627 \u062a\u0644\u0627\u0647 \u0639\u0644\u064a\u0643 \u062c\u0628\u0631\u064a\u0644 -\u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645-."},{"word":"\u0641\u064e\u0627\u062a\u0651\u064e\u0628\u0650\u0639\u0652 \u0642\u064f\u0631\u0652\u0622\u0646\u064e\u0647\u064f","meaning":" \u0641\u0627\u0633\u062a\u0645\u0639 \u0644\u0647\u060c \u062b\u0645 \u0627\u0642\u0631\u0623\u0647 \u0643\u0645\u0627 \u0623\u0642\u0631\u0623\u0643."}],"attribution_ar":"\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647","grade_ar":"\u0635\u062d\u064a\u062d"}