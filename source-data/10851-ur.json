d\u0627\u062c\u0627\u0646","meaning":" \u0645\u0646 \u0627\u0644\u0645\u062d\u0627\u062c\u0629: \u0648\u0647\u064a \u0627\u0644\u0645\u062e\u0627\u0635\u0645\u0629 \u0648\u0627\u0644\u0645\u062c\u0627\u062f\u0644\u0629 \u0648\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062d\u062c\u0629\u060c \u0648\u0627\u0644\u0645\u0639\u0646\u0649: \u062a\u062c\u0627\u062f\u0644\u0627\u0646 \u0639\u0646\u0647 \u0639\u0646\u062f \u0627\u0644\u0633\u0624\u0627\u0644, \u0623\u0648 \u062a\u062f\u0627\u0641\u0639\u0627\u0646 \u0639\u0646\u0647 \u0627\u0644\u062c\u062d\u064a\u0645 \u0648\u0627\u0644\u0632\u0628\u0627\u0646\u064a\u0629."},{"word":"\u0627\u0644\u0628\u064e\u0637\u064e\u0644\u0629","meaning":" \u0627\u0644\u0633\u062d\u0631\u0629."}],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0645\u0633\u0644\u0645","grade_ar":"\u0635\u062d\u064a\u062d"}