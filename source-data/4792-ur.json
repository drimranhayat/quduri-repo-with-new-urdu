u0642\u064e\u0627\u0644\u064e\u062a\u0652: \u0642\u064e\u0627\u0644\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0647\u0650 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645: \u00ab\u0645\u064e\u0646\u0652 \u0623\u064e\u062d\u0652\u062f\u064e\u062b\u064e \u0641\u0650\u064a \u0623\u064e\u0645\u0652\u0631\u0650\u0646\u064e\u0627 \u0647\u064e\u0630\u064e\u0627 \u0645\u064e\u0627 \u0644\u064e\u064a\u0652\u0633\u064e \u0641\u0650\u064a\u0647\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u0631\u064e\u062f\u064c\u0651\u00bb \u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647.\n\u0648\u0644\u0645\u0633\u0644\u0645: \u00ab\u0645\u064e\u0646\u0652 \u0639\u064e\u0645\u0650\u0644\u064e \u0639\u064e\u0645\u064e\u0644\u064b\u0627 \u0644\u064e\u064a\u0652\u0633\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0623\u064e\u0645\u0652\u0631\u064f\u0646\u064e\u0627 \u0641\u064e\u0647\u064f\u0648\u064e \u0631\u064e\u062f\u0651\u064c\u00bb.","hadeeth_intro_ar":"\u0639\u064e\u0646\u0652 \u0639\u064e\u0627\u0626\u0650\u0634\u064e\u0629\u064e \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0642\u064e\u0627\u0644\u064e\u062a\u0652: \u0642\u064e\u0627\u0644\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0647\u0650 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645:","explanation_ar":"\u064a\u064f\u0628\u064e\u064a\u0651\u0650\u0646\u064f \u0627\u0644\u0646\u0628\u064a\u0651\u064f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0623\u0646\u0651\u064e \u0645\u064e\u0646 \u0627\u062e\u062a\u0631\u064e\u0639\u064e \u0641\u064a \u0627\u0644\u062f\u0651\u0650\u064a\u0646\u0650 \u0623\u0648 \u0639\u064e\u0645\u0650\u0644\u064e \u0639\u0645\u0644\u064b\u0627 \u0644\u0645 \u064a\u064e\u062f\u064f\u0644 \u0639\u0644\u064a\u0647 \u062f\u0644\u064a\u0644\u064c \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u0633\u0646\u0629\u060c \u0641\u0647\u0648 \u0645\u064e\u0631\u062f\u0648\u062f\u064c \u0639\u0644\u0649 \u0635\u0627\u062d\u0628\u0650\u0647 \u063a\u064a\u0631 \u0645\u0642\u0628\u0648\u0644 \u0639\u0646\u062f \u0627\u0644\u0644\u0647.","hints_ar":["\u0627\u0644\u0639\u0628\u0627\u062f\u0627\u062a \u0645\u0628\u0646\u0627\u0647\u0627 \u0639\u0644\u0649 \u0645\u0627 \u062c\u0627\u0621 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u0633\u0646\u0629\u060c \u0641\u0644\u0627 \u0646\u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0625\u0644\u0627 \u0628\u0645\u0627 \u0634\u064e\u0631\u064e\u0639\u064e \u0644\u0627 \u0628\u0627\u0644\u0628\u062f\u0639 \u0648\u0627\u0644\u0645\u064f\u062d\u0652\u062f\u064e\u062b\u0627\u062a.","\u0627\u0644\u062f\u064a\u0646 \u0644\u064a\u0633 \u0628\u0627\u0644\u0631\u0623\u064a \u0648\u0627\u0644\u0627\u0633\u062a\u062d\u0633\u0627\u0646\u060c \u0648\u0625\u0646\u0645\u0627 \u0628\u0627\u0644\u0627\u062a\u0628\u0627\u0639 \u0644\u0644\u0631\u0633\u0648\u0644 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645.","\u0647\u0630\u0627 \u0627\u0644\u062d\u062f\u064a\u062b \u062f\u0644\u064a\u0644\u064c \u0639\u0644\u0649 \u0643\u0645\u0627\u0644 \u0627\u0644\u062f\u064a\u0646.","\u0627\u0644\u0628\u062f\u0639\u0629 \u0647\u064a \u0643\u0644 \u0645\u0627 \u0623\u064f\u062d\u0652\u062f\u0650\u062b\u064e \u0641\u064a \u0627\u0644\u062f\u064a\u0646 \u0648\u0644\u0645 \u064a\u064e\u0643\u0646\u0652 \u0639\u0644\u0649 \u0639\u0647\u062f\u0650 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0648\u0623\u0635\u062d\u0627\u0628\u0647 \u0645\u0646 \u0639\u0642\u064a\u062f\u0629\u064d \u0623\u0648 \u0642\u0648\u0644\u064d \u0623\u0648 \u0639\u0645\u0644\u064d.","\u0647\u0630\u0627 \u0627\u0644\u062d\u062f\u064a\u062b \u0623\u0635\u0644\u064c \u0645\u0646 \u0623\u0635\u0648\u0644 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u060c \u0648\u0647\u0648 \u0643\u0627\u0644\u0645\u064a\u0632\u0627\u0646 \u0644\u0644\u0623\u0639\u0645\u0627\u0644\u060c \u0641\u0643\u0645\u0627 \u0623\u0646\u0651\u064e \u0643\u0644\u0651\u064e \u0639\u064e\u0645\u064e\u0644\u064d \u0644\u0627 \u064a\u064f\u0631\u0627\u062f \u0628\u0647 \u0648\u062c\u0647 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649\u060c \u0641\u0644\u064a\u0633 \u0644\u0639\u0627\u0645\u0644\u0647 \u0641\u064a\u0647 \u062b\u0648\u0627\u0628\u060c \u0641\u0643\u0630\u0644\u0643 \u0643\u0644\u0651\u064f \u0639\u0645\u0644 \u0644\u0627 \u064a\u0643\u0648\u0646 \u0648\u0650\u0641\u0652\u0642\u064e \u0645\u0627 \u062c\u0627\u0621 \u0628\u0647 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0641\u0647\u0648 \u0645\u0631\u062f\u0648\u062f \u0639\u0644\u0649 \u0639\u0627\u0645\u0644\u0647.","\u0627\u0644\u0645\u064f\u062d\u0652\u062f\u064e\u062b\u0627\u062a \u0627\u0644\u0645\u0646\u0647\u064a \u0639\u0646\u0647\u0627 \u0645\u0627 \u0643\u0627\u0646 \u0645\u0646 \u0623\u0645\u0648\u0631 \u0627\u0644\u062f\u064a\u0646 \u0648\u0644\u064a\u0633 \u0627\u0644\u062f\u0646\u064a\u0627."],"words_meanings_ar":[],"attribution_ar":"\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647","grade_ar":"\u0635\u062d\u064a\u062d"}