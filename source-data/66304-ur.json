644 \u0641\u0631\u0645\u0627\u06cc\u0627: {\u064a\u064e\u0627 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0627\u0644\u0645\u064f\u062f\u0651\u064e\u062b\u0651\u0650\u0631\u064f} \u06cc\u0639\u0646\u06cc \u0627\u067e\u0646\u06d2 \u06a9\u067e\u0691\u0648\u06ba \u0645\u06cc\u06ba \u0644\u067e\u0679\u0646\u06d2 \u0648\u0627\u0644\u06d2\u060c {\u0642\u064f\u0645\u0652} \u062f\u0639\u0648\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u06be\u0691\u06d2 \u06c1\u0648 \u062c\u0627\u0626\u06cc\u06d2 {\u0641\u064e\u0623\u064e\u0646\u0652\u0630\u0650\u0631\u0652} \u0627\u0648\u0631 \u0627\u0646 \u06a9\u0648 \u062e\u0628\u0631\u062f\u0627\u0631 \u06a9\u06cc\u062c\u06cc\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u06cc \u0631\u0633\u0627\u0644\u062a \u067e\u0631 \u0627\u06cc\u0645\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u0644\u0627\u0626\u06d2 \u06c1\u06cc\u06ba\u06d4 {\u0648\u064e\u0631\u064e\u0628\u0651\u064e\u0643\u064e} \u0627\u067e\u0646\u06d2 \u0645\u0639\u0628\u0648\u062f \u06a9\u06cc\u060c {\u0641\u064e\u0643\u064e\u0628\u0651\u0650\u0631\u0652} \u062d\u0645\u062f \u0648\u0639\u0638\u0645\u062a \u0628\u06cc\u0627\u0646 \u06a9\u0631\u06cc\u06ba\u06d4 {\u0648\u064e\u062b\u0650\u064a\u064e\u0627\u0628\u064e\u0643\u064e} \u0627\u067e\u0646\u06d2 \u0644\u0628\u0627\u0633 \u06a9\u0648 {\u0641\u064e\u0637\u064e\u0647\u0651\u0650\u0631\u0652} \u0646\u062c\u0627\u0633\u062a\u0648\u06ba \u0633\u06d2 \u067e\u0627\u06a9 \u0635\u0627\u0641 \u0631\u06a9\u06be\u06cc\u06ba\u060c {\u0648\u064e\u0627\u0644\u0631\u0651\u064f\u062c\u0652\u0632\u064e} \u0628\u062a\u0648\u06ba \u0627\u0648\u0631 \u0645\u0648\u0631\u062a\u06cc\u0648\u06ba \u06a9\u06cc \u0639\u0628\u0627\u062f\u062a \u06a9\u0648 {\u0641\u064e\u0627\u0647\u0652\u062c\u064f\u0631\u0652} \u0686\u06be\u0648\u0691 \u062f\u06cc\u06ba\u060c \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0648\u062d\u06cc \u0645\u06cc\u06ba \u062a\u06cc\u0632\u06cc \u0622\u06af\u0626\u06cc \u0627\u0648\u0631 \u06a9\u062b\u0631\u062a \u0633\u06d2 \u0646\u06